# Payload CMS Secret
PAYLOAD_SECRET=your_super_secret_payload_key_minimum_32_characters

# Supabase / PostgreSQL Database Connection (Use Transaction Pooler port 6543)
DATABASE_URI=postgresql://postgres.yourprojectid:***@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL=postgresql://postgres.yourprojectid:***@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Cloudflare R2 / S3 Image Storage (10 GB Free Storage)
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET=storelink-images
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_URL=https://your-r2-public-url

# Trello (cuenta MAESTRA global — cada tenant solo configura su listId destino)
TRELLO_API_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Resend (clave global de envío; un tenant puede traer la suya vía panel BYOK)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=pedidos@flow.martes.app
RESEND_FROM_NAME=Flow Notificaciones

# Tasa de cambio VES de respaldo cuando Binance/dolarAPI no respondan
FALLBACK_EXCHANGE_RATE_VES=890

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://flow.martes.app

# Anti-abuso del checkout (Sprint 5): Upstash Redis free tier (upstash.io),
# crear la BD en la MISMA región que el deploy de Vercel para latencia baja
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Máximo de checkouts por minuto por IP+tienda (default 5 si no se define)
RATE_LIMIT_CHECKOUT_PER_MIN=5

# Secreto HMAC del nonce anti-replay del checkout (opcional; si se omite usa PAYLOAD_SECRET)
CHECKOUT_NONCE_SECRET=
