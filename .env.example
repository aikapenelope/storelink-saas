# Payload CMS Secret
PAYLOAD_SECRET=your_super_secret_payload_key_minimum_32_characters

# Supabase / PostgreSQL Database Connection (Use Transaction Pooler port 6543)
DATABASE_URI=postgresql://postgres.yourprojectid:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Cloudflare R2 / S3 Image Storage (10 GB Free Storage)
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET=storelink-images
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_REGION=auto

# Public Site URL
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
